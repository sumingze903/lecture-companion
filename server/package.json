{
  "name": "lecture-companion-server",
  "version": "0.1.0",
  "private": false,
  "description": "Translation API for Lecture Companion.",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development PORT=${PORT:-8787} tsx ./src/index.ts",
    "start": "node dist/index.js",
    "build": "tsx ./build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
